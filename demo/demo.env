# Valores FICTÍCIOS, só para a demo local (demo/docker-compose.demo.yml).
# Nenhum deles é usado em produção; nada aqui é segredo.
DEMO_POSTGRES_PASSWORD=demo-senha-ficticia
DEMO_JWT_SECRET=demo-jwt-ficticio
DEMO_SERVICE_TOKEN=demo-token-servico-ficticio
DEMO_DECISION_TOKEN=demo-token-decisao-ficticio
DEMO_USER_KEY_SECRET=demo-segredo-user-key-ficticio
# O módulo do Resend lança na importação sem chave; nenhum e-mail é enviado.
DEMO_RESEND_API_KEY=re_demo_ficticio
